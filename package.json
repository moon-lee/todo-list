{
  "name": "todo-list",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "financeExtension": {
    "id": "todo-list",
    "displayName": "Todo List",
    "version": "0.1.0",
    "description": "Todo List extension",
    "activationEvents": ["onView:todo-list"],
    "contributions": {
      "views": [{ "id": "todo-list", "name": "Todo List", "icon": "T" }],
      "commands": [{ "id": "todo-list.hello", "title": "Todo List: Hello" }],
      "navigation": [{ "id": "todo-list-main", "label": "Todo List", "command": "todo-list.hello", "group": "Todo List" }],
      "allowedCommands": ["todo-list.hello"],
      "allowedUiEvents": []
    },
    "tables": [
      {
        "name": "todo_list_items",
        "columns": [
          { "name": "title", "type": "text", "nullable": false },
          { "name": "created_at", "type": "datetime", "nullable": false, "default": "now" }
        ]
      }
    ],
    "main": "src/main.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "node D:/finance_flow_ai/scripts/sdk/cli.mjs build ."
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "lit": "^3.1.0"
  }
}
